{
	"description": "boxbox: inspects TypeScript, Python, JSON, and YAML session changes after matched file-edit and shell tools and at completion, read-only. Records stay in host plugin data.",
	"hooks": {
		"SessionStart": [
			{ "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/boxbox hook session", "timeout": 120 } ] }
		],
		"PostToolUse": [
			{ "matcher": "^(Write|Edit|MultiEdit|apply_patch|Bash)$", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/boxbox hook post", "timeout": 120 } ] }
		],
		"Stop": [
			{ "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/boxbox hook stop", "timeout": 120 } ] }
		]
	}
}
