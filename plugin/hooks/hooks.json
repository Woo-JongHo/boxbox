{
	"description": "xxx: 세션 중 바뀐 TypeScript·Python 파일을 읽기 전용으로 검사한다. 기록은 플러그인 데이터 폴더에 남고 사용자 프로젝트에는 파일을 만들지 않는다.",
	"hooks": {
		"SessionStart": [
			{ "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/xxx hook session", "timeout": 120 } ] }
		],
		"PostToolUse": [
			{ "matcher": "Write|Edit|MultiEdit|apply_patch", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/xxx hook post", "timeout": 120 } ] }
		],
		"Stop": [
			{ "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/xxx hook stop", "timeout": 120 } ] }
		]
	}
}
