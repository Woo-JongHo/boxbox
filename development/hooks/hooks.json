{
	"description": "boxbox: guides readability principles while code is written and reports only newly introduced alarms afterwards (read-only). Disable with BOXBOX_HOOKS=off.",
	"hooks": {
		"SessionStart": [
			{ "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/product/engine/hook.ts\" session", "timeout": 10 } ] }
		],
		"PreToolUse": [
			{ "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/product/engine/hook.ts\" pre", "timeout": 10 } ] }
		],
		"PostToolUse": [
			{ "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/product/engine/hook.ts\" post", "timeout": 60 } ] }
		]
	}
}
