 export async function syntacticDiagnostics(root: string, absolute: string, text: string): Promise<readonly string[]> {
+	diagnosticStage(`diagnostics:api:create:start file=${absolute}`);
 	const api = new API({ cwd: root });
+	diagnosticStage(`diagnostics:api:create:done file=${absolute}`);
 	try {
+		diagnosticStage(`diagnostics:snapshot:start file=${absolute}`);
 		const state   = await api.updateSnapshot({ openFiles: [absolute] }) ;
+		diagnosticStage(`diagnostics:snapshot:done file=${absolute}`);
+		diagnosticStage(`diagnostics:project:start file=${absolute}`);
 		const project = await state.getDefaultProjectForFile(absolute)      ;
+		diagnosticStage(`diagnostics:project:done file=${absolute}`);
 		if (!project) throw new Error(`cannot find a TypeScript project: ${absolute}`);
+		diagnosticStage(`diagnostics:get:start file=${absolute}`);
 		const found = await project.program.getSyntacticDiagnostics(absolute);
+		diagnosticStage(`diagnostics:get:done file=${absolute}`);
 		return found.map(diagnostic => `${text.slice(0, diagnostic.pos).split("\n").length}:${diagnostic.code}`).sort();
 	} finally {
+		diagnosticStage(`diagnostics:close:start file=${absolute}`);
 		await api.close();
+		diagnosticStage(`diagnostics:close:done file=${absolute}`);
 	}
 }
