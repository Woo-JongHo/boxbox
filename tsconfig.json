{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": [
			"bun-types"
		],
		"paths": {
			"@/*": [
				"./product/engine/*"
			]
		}
	},
	"include": [
		"product/engine/**/*.ts",
		"test/**/*.ts",
		"development/harness/**/*.ts",
		"development/tools/**/*.ts"
	],
	"exclude": [
		"test/fixtures/**"
	]
}
