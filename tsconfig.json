{
	"compilerOptions": {
		"target"                      : "esnext",
		"module"                      : "esnext",
		"moduleResolution"            : "bundler",
		"strict"                      : true,
		"noEmit"                      : true,
		"skipLibCheck"                : true,
		"allowImportingTsExtensions"  : true,
		"types"                       : ["bun-types"],
		"paths"                       : { "@/*": ["./skills/xxx/scripts/*"] }
	},
	"include": ["skills/**/*.ts", "test/**/*.ts", "harness/**/*.ts"],
	"exclude": ["skills/**/fixtures/**"]
}
