		"rules/presets/recommended/decisions.jsonl",
		"rules/presets/recommended/docs/public",
		"THIRD_PARTY_NOTICES",
		"README.md"
	],
	"bin": {
		"boxbox": "dist/cli.js"
	},
	"dependencies": {
		"typescript": "7.0.2"
	}
}
