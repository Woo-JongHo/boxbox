{
	"name"       : "boxbox",
	"version"    : "@BOXBOX_VERSION@",
	"private"    : true,
	"license"    : "MIT",
	"description": "Development candidate for the BoxBox TypeScript, Python, JSON and YAML command-line engine",
	"type"       : "module",
	"engines": {
		"node": ">=22.22.3"
	},
	"files": [
		"dist/cli.js",
		"rules/presets/recommended/conventions.jsonl",
