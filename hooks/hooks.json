{
	"description": "xxx: 코드를 쓸 때 가독성 원칙을 안내하고, 쓴 뒤 새로 생긴 알람만 알린다 (읽기 전용). XXX_HOOKS=off로 끈다.",
	"hooks": {
		"SessionStart": [
			{ "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/skills/xxx/scripts/hook.ts\" session", "timeout": 10 } ] }
		],
		"PreToolUse": [
			{ "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/skills/xxx/scripts/hook.ts\" pre", "timeout": 10 } ] }
		],
		"PostToolUse": [
			{ "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/skills/xxx/scripts/hook.ts\" post", "timeout": 60 } ] }
		]
	}
}
